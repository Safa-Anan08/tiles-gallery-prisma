{
  "openapi": "3.0.3",
  "info": {
    "title": "Tiles Gallery Express API",
    "description": "SCIC/EJP-13 Full Compliance Express + TypeScript Backend API for Tiles Gallery",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check Endpoint",
        "responses": {
          "200": { "description": "API is healthy" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register New User",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" },
          "400": { "description": "Validation error or user already exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get Authenticated User Profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user profile fetched successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout User",
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/tiles": {
      "get": {
        "summary": "List All Active Tiles",
        "responses": {
          "200": { "description": "Tiles fetched successfully" }
        }
      },
      "post": {
        "summary": "Create Tile (Admin Only)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Tile created successfully" },
          "403": { "description": "Admin access required" }
        }
      }
    },
    "/tiles/{id}": {
      "get": {
        "summary": "Get Tile By ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Tile fetched successfully" },
          "404": { "description": "Tile not found" }
        }
      },
      "put": {
        "summary": "Update Tile (Admin Only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Tile updated successfully" }
        }
      },
      "delete": {
        "summary": "Delete Tile (Admin Only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Tile deleted successfully" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "List All Categories",
        "responses": {
          "200": { "description": "Categories retrieved successfully" }
        }
      },
      "post": {
        "summary": "Create Category (Admin Only)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Category created successfully" }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "summary": "Get Category By ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Category retrieved successfully" }
        }
      },
      "put": {
        "summary": "Update Category (Admin Only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Category updated successfully" }
        }
      },
      "delete": {
        "summary": "Delete Category (Admin Only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Category deleted successfully" }
        }
      }
    },
    "/reviews": {
      "get": {
        "summary": "Get Reviews By Tile ID",
        "parameters": [{ "name": "tileId", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Reviews retrieved successfully" }
        }
      },
      "post": {
        "summary": "Create Review",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Review created successfully" }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get User Cart Items",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Cart fetched successfully" }
        }
      },
      "post": {
        "summary": "Add Item to Cart",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Item added to cart" }
        }
      },
      "delete": {
        "summary": "Remove Item from Cart",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Item deleted from cart" }
        }
      }
    },
    "/wishlist": {
      "get": {
        "summary": "Get User Wishlist Items",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Wishlist fetched successfully" }
        }
      },
      "post": {
        "summary": "Add Item to Wishlist",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Item added to wishlist" }
        }
      },
      "delete": {
        "summary": "Remove Item from Wishlist",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Item deleted from wishlist" }
        }
      }
    },
    "/user/update": {
      "put": {
        "summary": "Update Profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile updated successfully" }
        }
      }
    },
    "/contact-us": {
      "post": {
        "summary": "Submit Contact Message",
        "responses": {
          "200": { "description": "Message sent successfully" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
